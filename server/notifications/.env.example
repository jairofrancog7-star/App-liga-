# Ejemplo: NUNCA guardar valores reales en GitHub Pages, código o index.html.
PORT=8080
DATABASE_URL=postgres://usuario:CLAVE@host:5432/liga?sslmode=require
WEB_ORIGIN=https://jairofrancog7-star.github.io
PUBLIC_API_ORIGIN=https://api-tu-dominio.example
LJR_MEDIA_AUTH_BASE=https://liga-juventino-media.ruchiz27mb0698.chatgpt.site
# El backend verifica Authorization: Bearer de la sesión oficial contra LJR_MEDIA_AUTH_BASE/api/me.
# NO existe ADMIN_NOTIFY_TOKEN en el navegador.
JOB_NOTIFY_TOKEN=REEMPLAZAR_CON_OTRO_TOKEN_ALEATORIO
VAPID_PUBLIC_KEY=GENERAR_CON_npx_web-push_generate-vapid-keys
VAPID_PRIVATE_KEY=CLAVE_PRIVADA_SOLO_EN_BACKEND
VAPID_SUBJECT=mailto:admin@tu-dominio.example
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=SECRETO_SERVIDOR
TWILIO_AUTH_TOKEN=SOLO_PARA_VALIDAR_WEBHOOKS
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Usa el formato E.164 (México: whatsapp:+52 seguido de 10 dígitos), únicamente tras registrar el remitente en Twilio/Meta.
# Registrar candidato en Railway no equivale a comprobar su titularidad.
TWILIO_WHATSAPP_SENDER=whatsapp:+NUMERO_APROBADO
# Mantener false hasta que Twilio confirme el remitente y Meta apruebe la plantilla.
TWILIO_WHATSAPP_ACTIVATED=false
TWILIO_WHATSAPP_CONTENT_SID=HX_PLANTILLA_APROBADA
# GitHub Actions: guardar LJR_NOTIFICATIONS_API_URL y LJR_NOTIFICATIONS_JOB_TOKEN como secretos del repositorio.
